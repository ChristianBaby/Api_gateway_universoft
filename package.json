{
  "name": "ruwark-api-gateway",
  "version": "1.0.0",
  "description": "API Gateway para la Plataforma Ruwark - Microservicios",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "test:marketing-cms": "node --test --test-isolation=none tests/marketing-cms.routes.test.js",
    "test:marketing-editor": "node --test --test-isolation=none tests/marketing-editor.routes.test.js",
    "test:marketing-video": "node --test --test-isolation=none tests/marketing-video.routes.test.js",
    "test:marketing-publicaciones": "node --test --test-isolation=none tests/marketing-publicaciones.routes.test.js"
  },
  "keywords": [
    "api-gateway",
    "microservices",
    "express",
    "ruwark"
  ],
  "author": "Ruwark Team",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "http-proxy-middleware": "^2.0.6",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "node": "^25.6.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
