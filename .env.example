api gateway  # ============================================
# CONFIGURACIÓN DEL API GATEWAY
# ============================================

# Puerto del Gateway
PORT=8080

# Entorno
NODE_ENV=development

# ============================================
# SERVICIOS INTERNOS
# ============================================

# Backend de autenticación (Microservicio Login)
AUTH_SERVICE_URL=http://localhost:4000

# Microservicio de Recursos Humanos (proxy /rrhh-api)
# En Docker/EasyPanel debe apuntar al nombre interno del servicio RRHH.
RRHH_URL=http://localhost:7100

# Microservicio General
GENERAL_SERVICE_URL=http://localhost:4001

# Microservicio de operaciones
OPERACIONES_SERVICE_URL=http://localhost:4002

# Microservicio de ventas
VENTAS_SERVICE_URL=http://localhost:4003

# Microservicio Tramitador MINCUL
TRAMITADOR_SERVICE_URL=http://localhost:4013
GEOMETRIAS_SERVICE_URL=http://localhost:4016
GEOPROCESOS_SERVICE_URL=http://localhost:4017

# Microservicio de clientes
CLIENTES_SERVICE_URL=http://localhost:7000

# Microservicio CMS Marketing
CMS_SERVICE_URL=http://localhost:4007

# Microservicio IA Marketing
AI_SERVICE_URL=http://localhost:4011

# Microservicio QGIS
# QGIS_SERVICE_URL=http://localhost:5000
QGIS_SERVICE_URL=http://72.60.116.45:5555

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:3000,http://localhost:3002,https://staging-rwk-frontend-ruwark.nfnbzo.easypanel.host,https://staging-rwk-panel-cliente-ruwark.nfnbzo.easypanel.host


# Microservicio de memoria descriptiva
MEMORIA_DESCRIPTIVA_SERVICE_URL=https://appsruwark-micro-memoria-descriptiva.v3z7ma.easypanel.host

# Microservicio editor de imagen/marketing
MICRO_EDITOR_IMAGEN_URL=http://localhost:4008

# Microservicio publicaciones de marketing/redes
MICRO_PUBLICACIONES_URL=http://localhost:4010
MICRO_PUBLICACIONES_TIMEOUT_MS=45000


# ============================================
# SEGURIDAD
# ============================================
# reCAPTCHA Secret Key 
RECAPTCHA_SECRET_KEY=6LeD3YQsAAAAAP4n8OZged8NiDwCijf3lk9KRVB2

# Secret para JWT (debe coincidir con los servicios)
# Configurar una clave aleatoria compartida con login; nunca usar una clave de ejemplo.
JWT_SECRET=
# Orígenes adicionales explícitos, separados por comas (incluye el ID exacto de extensiones autorizadas).
CORS_ORIGINS=

# Token para comunicación entre microservicios
MICROSERVICE_TOKEN=gateway-secret-token-2024
